{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "edit": "ask",
        "bash": "ask",
        "webfetch": "allow",
        "websearch": "allow"
    },
    "mcp": {
        "searxng": {
            "type": "local",
            "command": ["mcp-searxng"],
            "environment": { "SEARXNG_URL": "http://localhost:<PORT>" }
        }
    },
    "provider": {
        "ollama": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Ollama (local)",
            "options": { "baseURL": "http://localhost:<PORT|11434>/v1" },
            "models": {
                "qwen3.5:9b-mlx": {
                    "limit": { "context": 32000, "output": 8000 }
                },
                "gemma4:12b-mlx": {}
            }
        }
    }
}
